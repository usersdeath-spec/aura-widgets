<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      The app's only XML theme. Everything visible is Compose; this exists to set the window
      background and system bars before the first frame, so launching does not flash white on a
      dark-themed device.
    -->
    <style name="Theme.Prism" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/prism_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!--
      Platform SplashScreen API, no custom activity and no artificial delay. The icon animates for
      exactly as long as the app takes to be ready; setKeepOnScreenCondition is released once the
      catalog is built. A splash that lingers to show branding is one users learn to resent.
    -->
    <style name="Theme.Prism.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/prism_icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        
        <item name="postSplashScreenTheme">@style/Theme.Prism</item>
    </style>
</resources>
