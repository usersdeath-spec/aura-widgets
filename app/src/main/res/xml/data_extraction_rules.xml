<?xml version="1.0" encoding="utf-8"?>
<!--
  What leaves the device in a backup or a device-to-device transfer.

  Included: the user's work — placed widgets, styles, favourites, recents, saved presets.
  Excluded: the billing entitlement cache and the feed cache. The entitlement is re-derived from
  Google Play on the new device, so restoring a stale one would either wrongly unlock or wrongly
  lock the app. The feed cache is stale weather; there is no reason to carry it.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="prism.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="file" path="feed_weather.json" />
        <exclude domain="file" path="feed_finance.json" />
        <exclude domain="file" path="feed_crypto.json" />
        <exclude domain="file" path="feed_quote.json" />
        <exclude domain="sharedpref" path="license.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="prism.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="license.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
