<?xml version="1.0" encoding="utf-8"?>
<!--
  The entire visual widget is one ImageView.

  Rasterising in :core:render and handing the host a single bitmap buys us gradients, blur, mesh
  surfaces, hairline strokes, and optical typography — none of which RemoteViews can express — at
  the cost of one view to inflate. Interactive widgets (music transport, todo checkboxes) add
  transparent Buttons on top of this frame at runtime; nothing else is ever inflated here.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/Theme.Prism.Widget">

    <ImageView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="yes" />

    <FrameLayout
        android:id="@+id/touch_targets"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
